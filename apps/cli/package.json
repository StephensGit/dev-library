{
  "name": "@stephenmoran/devlib",
  "version": "0.1.0",
  "description": "Command-line client for Dev Library: search and list your saved developer commands from the terminal.",
  "keywords": [
    "cli",
    "commands",
    "snippets",
    "developer-tools",
    "dev-library",
    "devlib"
  ],
  "homepage": "https://github.com/StephensGit/dev-library/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/StephensGit/dev-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephensGit/dev-library.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "Stephen Moran",
  "type": "module",
  "bin": {
    "devlib": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
