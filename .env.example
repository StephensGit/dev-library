DATABASE_URL=

# Better Auth: generate the secret with `openssl rand -base64 32`.
# The URL is where the browser reaches the app (the Vite dev server locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Optional: database for `pnpm test`. Its name must end in _test.
# Defaults to DATABASE_URL with _test added to the database name.
# TEST_DATABASE_URL=
