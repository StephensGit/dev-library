DATABASE_URL=

# Better Auth: generate the secret with `openssl rand -base64 32`.
# The URL is where the browser reaches the app (the Vite dev server locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Public registration (POST /api/auth/sign-up/email): "true" or "false".
# Defaults to false in production and true elsewhere. With it off, create accounts with the
# create-user script (see the README). Existing accounts can always log in.
# SIGNUP_ENABLED=

# Who may register: comma-separated emails, matched case-insensitively. Also applies to the
# create-user script when set. Required in production only when SIGNUP_ENABLED=true.
# Leave unset locally to let anyone register.
# SIGNUP_ALLOWED_EMAILS=you@example.com,friend@example.com

# Which proxies may report the client IP. Leave unset locally.
# In production behind a reverse proxy: a hop count (e.g. 1) or proxy IPs/CIDRs (e.g. 10.0.0.0/8). Never "true".
# TRUST_PROXY=

# Optional: where the API listens. PORT defaults to 3000. HOST defaults to localhost,
# or 0.0.0.0 when NODE_ENV=production (so the hosting platform's proxy can reach it).
# PORT=
# HOST=

# Optional: database for `pnpm test`. Its name must end in _test.
# Defaults to DATABASE_URL with _test added to the database name.
# TEST_DATABASE_URL=

# Optional: the API the CLI (devlib) talks to. Defaults to http://localhost:3000.
# Must be https:// unless it's localhost. The CLI reads this from your shell, not from this file.
# DEVLIB_API_URL=
